# ─── 应用配置 ───
APP_NAME='AI Knowledge Base Agent Platform'
DEBUG=True

# CORS 允许来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── MySQL 配置 ───
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_kb_platform

# ─── PostgreSQL 配置 ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pg_password
POSTGRES_DATABASE=ai_kb_vector

# ─── Redis 配置 ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── JWT 配置 ───
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM 配置 ───
LLM_API_KEY=your_api_key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
# 上游超时与重试：没有这两项，一次 429/5xx 就会直接变成用户可见的失败
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ─── Embedding 配置 ───
# 三个值必须与数据库列 document_chunks.embedding 的维度一致，否则写入会失败。
# 换模型 = 换维度 = 需要迁移列（见 docs/FIX_PLAN.md 的 B5-2）。
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
# 一批最多几条文本（长文档几百个切片，分批提交才不会被上游批大小/超时卡住）
EMBEDDING_BATCH_SIZE=32

# ─── Agent 搜索配置 ───
# 搜索 API 地址，留空则返回模拟结果
SEARCH_API_URL=

# ─── 上下文与 Agent ───
# 送进 LLM 的历史消息条数上限（后续改为 token 预算，见 B3-1）
CONTEXT_HISTORY_LIMIT=20
# 单次提问最多允许的工具调用轮数；超限会强制一次不带工具的总结
AGENT_MAX_ITERATIONS=10

# ─── 速率限制配置 ───
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_GLOBAL_PER_MINUTE=1000
# ─── 日志 ───
LOG_LEVEL=INFO
LOG_JSON=False
LOG_DIR=logs
# 打开后会把 SQL 与参数（含用户消息）打进日志，仅排障时临时开
DB_ECHO_SQL=False

# ─── 检索 / 登录安全 ───
# HNSW 候选集大小（越大召回越高、越慢）
HNSW_EF_SEARCH=40
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15